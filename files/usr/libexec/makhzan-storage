#!/bin/sh
# Makhzan - USB NAS manager for OpenWrt
# Copyright (C) 2026 dreamboxone
# SPDX-License-Identifier: GPL-3.0-only
#
# This program is free software: you can redistribute it and/or modify it under the terms
# of the GNU General Public License version 3 as published by the Free Software Foundation.
# It is distributed WITHOUT ANY WARRANTY; see the LICENSE file for details.
# USB disk operations: whole-disk planner, filesystem check and the read-only media library disk.
# Long operations run detached because rpcd limits command runtime.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
. /usr/libexec/makhzan-usb.sh || exit 1
JOB=/var/run/makhzan-storage.json
LOCK=/var/lock/makhzan-storage.lock
NAS_WARN_MIB=1024
LIB_TARGET=/mnt/makhzan-library
MODE=foreground
KIND=prepare
json_job() { printf '%s\n' "$1" > "$JOB.tmp" && mv -f "$JOB.tmp" "$JOB"; }
error() {
 if [ "$MODE" = job ]; then json_job "{\"state\":\"failed\",\"kind\":\"$KIND\",\"error\":\"$1\",\"finished\":$(date +%s)}"; fi
 printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1
}
step() { [ "$MODE" != job ] || json_job "{\"state\":\"running\",\"kind\":\"$KIND\",\"step\":\"$1\",\"started\":$started}"; }
uint() { case "$1" in ''|*[!0-9]*|0[0-9]*) return 1;; esac; [ ${#1} -le 9 ]; }
usb() {
 case "$1" in /dev/sd[a-z]|/dev/sd[a-z][a-z]) ;; *) return 1;; esac
 makhzan_usb_device "$1" && [ ! -f "/sys/class/block/${1#/dev/}/partition" ]
}
uuid() { block info "$1" | sed -n 's/.* UUID="\([^"]*\)".*/\1/p'; }
# One field (UUID, LABEL, TYPE) of a block device from block info.
binfo() { block info "$1" 2>/dev/null | sed -n "s/.* $2=\"\([^\"]*\)\".*/\1/p"; }
# Partitions of a whole disk that are mounted (prints "device mountpoint").
disk_mounts() {
 awk -v d="$1" '$1==d || (index($1,d)==1 && substr($1,length(d)+1) ~ /^[0-9]+$/) {print $1, $2}' /proc/mounts
}
disk_swaps() {
 awk -v d="$1" 'NR>1 && ($1==d || (index($1,d)==1 && substr($1,length(d)+1) ~ /^[0-9]+$/)) {print $1}' /proc/swaps
}
# Makhzan partitions already on a disk, found by the labels apply() gives them: size in MiB and
# whether each one is in use (NAS mounted as the Makhzan root, swap on, extroot as the overlay).
layout() {
 l_ext=0; l_swap=0; l_nas=0; a_ext=false; a_swap=false; a_nas=false
 l_root=$(uci -q get makhzan.main.root)
 for part in /sys/class/block/${1#/dev/}[0-9]*; do
  [ -f "$part/partition" ] || continue
  p_dev=/dev/${part##*/}; p_size=$(( $(cat "$part/size") / 2048 ))
  case "$(binfo "$p_dev" LABEL)" in
   makhzan-extroot)
    l_ext=$p_size
    awk -v d="$p_dev" '$1==d && ($2=="/" || $2=="/overlay" || $2=="/rom/overlay") {f=1} END {exit !f}' /proc/mounts && a_ext=true;;
   makhzan-swap)
    l_swap=$p_size
    awk -v d="$p_dev" 'NR>1 && $1==d {f=1} END {exit !f}' /proc/swaps && a_swap=true;;
   makhzan-nas)
    l_nas=$p_size
    if [ -n "$l_root" ] && awk -v d="$p_dev" -v m="$l_root" '$1==d && $2==m {f=1} END {exit !f}' /proc/mounts; then a_nas=true; fi;;
  esac
 done
 printf '{"extroot":%s,"swap":%s,"nas":%s,"active":{"extroot":%s,"swap":%s,"nas":%s}}' "$l_ext" "$l_swap" "$l_nas" "$a_ext" "$a_swap" "$a_nas"
}
devices() {
 printf '{"ok":true,"devices":['; sep=''
 for sys in /sys/block/sd*; do
  [ -e "$sys" ] || continue; dev=/dev/${sys##*/}; usb "$dev" || continue
  sectors=$(cat "$sys/size"); model=$(cat "$sys/device/model" 2>/dev/null | tr -cd 'A-Za-z0-9 ._-' | sed 's/ *$//')
  mounts=$(disk_mounts "$dev" | awk '{printf "%s\"%s\"", (n++?",":""), $2}'); swaps=$(disk_swaps "$dev" | wc -l)
  system=false; disk_mounts "$dev" | awk '$2=="/" || $2=="/overlay" || $2=="/rom/overlay" {f=1} END {exit !f}' && system=true
  printf '%s{"path":"%s","model":"%s","size_mib":%s,"mounts":[%s],"swap_active":%s,"system":%s,"layout":%s}' "$sep" "$dev" "$model" "$((sectors / 2048))" "$mounts" "$([ "$swaps" -gt 0 ] && echo true || echo false)" "$system" "$(layout "$dev")"; sep=,
 done
 printf ']}\n'
}
plan() {
 dev=$1; ext=$2; swap=$3; nas=$4
 usb "$dev" || error 'Select a whole USB disk'
 uint "$ext" && uint "$swap" && uint "$nas" || error 'Sizes must be nonnegative integer MiB'
 [ "$ext" -eq 0 ] || [ "$ext" -ge 128 ] || error 'Extroot minimum is 128 MiB'
 [ "$swap" -eq 0 ] || [ "$swap" -ge 16 ] || error 'Swap minimum is 16 MiB'
 [ "$nas" -eq 0 ] || [ "$nas" -ge 32 ] || error 'NAS minimum is 32 MiB'
 sectors=$(cat "/sys/block/${dev#/dev/}/size"); capacity=$((sectors / 2048)); used=$((ext + swap + nas))
 [ "$used" -gt 0 ] || error 'Select at least one role'
 [ "$used" -le "$((capacity - 16))" ] || error 'Selected sizes exceed usable capacity'
 if [ "$ext" -gt 0 ]; then
  overlay=$(makhzan_overlay_dir) || error 'Unsupported overlay layout; extroot is not available on this router'
  kib=$(du -sk "$overlay" | awk '{print $1}')
  [ "$ext" -gt "$((kib / 1024 + 64))" ] || error 'Extroot is too small for existing overlay plus reserve'
 fi
 free=$((capacity - used - 16))
 # Warning only: extroot and/or swap leave no useful room for the file server.
 nas_warning=false; consumers=''
 if [ "$nas" -eq 0 ] && [ "$free" -lt "$NAS_WARN_MIB" ]; then
  [ "$ext" -eq 0 ] || consumers='"extroot"'
  [ "$swap" -eq 0 ] || consumers="${consumers:+$consumers,}\"swap\""
  [ -z "$consumers" ] || nas_warning=true
 fi
}
plan_json() {
 printf '{"ok":true,"capacity_mib":%s,"reserved_mib":16,"unallocated_mib":%s,"nas_space_warning":%s,"nas_space_consumers":[%s],"nas_warning_threshold_mib":%s}\n' "$capacity" "$free" "$nas_warning" "$consumers" "$NAS_WARN_MIB"
}
busy_check() {
 [ -z "$(disk_mounts "$dev")" ] || error 'Disk is mounted; release it first. Active extroot requires internal-storage reboot'
 [ -z "$(disk_swaps "$dev")" ] || error 'Disk contains active swap; release it first'
 for sys in /sys/class/block/${dev#/dev/}*; do
  [ -e "$sys" ] || continue
  for holder in "$sys"/holders/*; do [ ! -e "$holder" ] || error 'Disk has active device-mapper or RAID holders'; done
 done
}
preflight() {
 plan "$1" "$2" "$3" "$4"
 [ "$5" = "ERASE:$dev:$ext:$swap:$nas" ] || error 'Explicit erase confirmation is missing'
 busy_check
 [ "$ext" -eq 0 ] || [ "$(uci -q get fstab.afzoon_extroot.enabled)" != 1 ] || error 'Disable the existing Afzoon extroot configuration before creating another'
 for tool in parted partprobe mkfs.ext4 mkswap swapon swapoff block mount umount uci; do command -v "$tool" >/dev/null || error 'A required storage tool is missing'; done
 [ "$nas" -eq 0 ] || ! makhzan_mounted /mnt/makhzan || error 'NAS target is already mounted; release it first'
 clear_stale
 [ ! -d "$LOCK" ] || error 'Another storage operation is running'
}
# Hotplug may auto-mount or swapon stale signatures on fresh partitions; detach before formatting.
detach() {
 grep -q "^$1 " /proc/swaps && swapoff "$1" 2>/dev/null
 while awk -v d="$1" '$1==d {f=1} END {exit !f}' /proc/mounts; do umount "$1" 2>/dev/null || return 1; done
 return 0
}
# The lock directory is created by apply() before this detached job starts; the job records its pid so a
# killed job can be recognised (see job_status) instead of looking busy forever.
run() {
 MODE=job; started=$(date +%s)
 [ -d "$LOCK" ] || error 'Storage job started without its lock'
 echo $$ > "$LOCK/pid"
 stage=''; trap 'if [ -n "$stage" ]; then umount "$stage" 2>/dev/null; rmdir "$stage" 2>/dev/null; fi; rm -rf "$LOCK"' EXIT
 step checking
 preflight_locked "$@"
 step partitioning
 usb "$dev" || error 'USB identity changed; refusing to write'
 parted -s "$dev" mklabel gpt >/dev/null 2>&1 || error 'Partition table creation failed'
 start=1; num=1; ep=''; sp=''; np=''
 for role in extroot swap nas; do
  case "$role" in extroot) size=$ext; type=ext4;; swap) size=$swap; type=linux-swap;; nas) size=$nas; type=ext4;; esac
  [ "$size" -gt 0 ] || continue; end=$((start + size))
  parted -s "$dev" mkpart primary "$type" "${start}MiB" "${end}MiB" >/dev/null 2>&1 || error 'Partition creation failed; disk may be partially partitioned'
  case "$role" in extroot) ep=$dev$num;; swap) sp=$dev$num;; nas) np=$dev$num;; esac
  start=$end; num=$((num+1))
 done
 partprobe "$dev" >/dev/null 2>&1 || error 'Kernel partition refresh failed'
 for part in "$ep" "$sp" "$np"; do
  [ -n "$part" ] || continue; tries=0
  while [ ! -b "$part" ] && [ "$tries" -lt 10 ]; do sleep 1; tries=$((tries+1)); done
  [ -b "$part" ] || error 'Partition device did not appear'
  makhzan_usb_device "$part" || error 'Partition is not on a physical USB disk'
 done
 sleep 2
 step formatting
 for part in "$ep" "$sp" "$np"; do [ -z "$part" ] || detach "$part" || error 'A new partition was auto-mounted and could not be released'; done
 [ -z "$ep" ] || mkfs.ext4 -q -F -L makhzan-extroot "$ep" >/dev/null 2>&1 || error 'Extroot formatting failed'
 # A NAS partition holds only user data: no root-reserved blocks (ext4 would hide 5% by default).
 # Extroot keeps the default reserve because it is the router's system storage.
 [ -z "$np" ] || mkfs.ext4 -q -F -m 0 -L makhzan-nas "$np" >/dev/null 2>&1 || error 'NAS formatting failed'
 [ -z "$sp" ] || mkswap -L makhzan-swap "$sp" >/dev/null 2>&1 || error 'Swap formatting failed'
 eu=''; su=''; nu=''
 if [ -n "$ep" ]; then eu=$(uuid "$ep"); [ -n "$eu" ] || error 'Extroot UUID missing'; fi
 if [ -n "$sp" ]; then su=$(uuid "$sp"); [ -n "$su" ] || error 'Swap UUID missing'; fi
 if [ -n "$np" ]; then nu=$(uuid "$np"); [ -n "$nu" ] || error 'NAS UUID missing'; fi
 step configuring
 for section in makhzan_extroot makhzan_swap makhzan_nas; do uci -q delete "fstab.$section"; done
 if [ -n "$eu" ]; then
  uci set fstab.makhzan_extroot=mount; uci set fstab.makhzan_extroot.uuid="$eu"; uci set fstab.makhzan_extroot.target=/overlay; uci set fstab.makhzan_extroot.fstype=ext4; uci set fstab.makhzan_extroot.options=rw,noatime; uci set fstab.makhzan_extroot.enabled=0
 fi
 if [ -n "$su" ]; then uci set fstab.makhzan_swap=swap; uci set fstab.makhzan_swap.uuid="$su"; uci set fstab.makhzan_swap.enabled=1; fi
 if [ -n "$nu" ]; then
  uci set fstab.makhzan_nas=mount; uci set fstab.makhzan_nas.uuid="$nu"; uci set fstab.makhzan_nas.target=/mnt/makhzan; uci set fstab.makhzan_nas.fstype=ext4; uci set fstab.makhzan_nas.options=rw,noatime; uci set fstab.makhzan_nas.enabled=1
  uci set makhzan.main.root=/mnt/makhzan
 fi
 uci set makhzan.main.storage_extroot_uuid="$eu"; uci set makhzan.main.storage_boot="$(cat /proc/sys/kernel/random/boot_id)"; uci commit makhzan || error 'Configuration save failed'
 uci commit fstab || error 'Mount configuration save failed'
 if [ -n "$ep" ]; then
  step copying_overlay
  stage=$(mktemp -d /tmp/makhzan-extroot.XXXXXX) || error 'Staging directory failed'
  mount -t ext4 "$ep" "$stage" || error 'Cannot mount extroot staging'
  cp -a "$overlay/." "$stage/" || error 'Overlay copy failed; extroot remains disabled'
  uci set fstab.makhzan_extroot.enabled=1; uci commit fstab || error 'Extroot activation configuration failed'
  mkdir -p "$stage/upper/etc/config" && cp /etc/config/fstab "$stage/upper/etc/config/fstab" || { uci set fstab.makhzan_extroot.enabled=0; uci commit fstab; error 'Staged mount configuration failed'; }
  sync; umount "$stage" || error 'Staging unmount failed'; rmdir "$stage"; stage=''
 fi
 step activating
 [ -z "$sp" ] || swapon "$sp" || error 'Swap activation failed'
 if [ -n "$np" ]; then
  mkdir -p /mnt/makhzan; mount -t ext4 -o rw,noatime "$np" /mnt/makhzan || error 'NAS mount failed'
  makhzan_usb_mount /mnt/makhzan || error 'NAS USB mount verification failed'
  makhzan_layout /mnt/makhzan || error 'NAS folder layout failed'
  # Refresh SMB shares and DLNA for the new disk when services were configured before.
  [ "$(uci -q get makhzan.main.enabled)" != 1 ] || /usr/sbin/makhzanctl apply >/dev/null 2>&1 || true
 fi
 sync
 reboot=false; [ -z "$ep" ] || reboot=true
 json_job "{\"state\":\"done\",\"kind\":\"prepare\",\"ok\":true,\"reboot_required\":$reboot,\"unallocated_mib\":$free,\"finished\":$(date +%s)}"
}
preflight_locked() {
 plan "$1" "$2" "$3" "$4"
 [ "$5" = "ERASE:$dev:$ext:$swap:$nas" ] || error 'Explicit erase confirmation is missing'
 busy_check
 [ "$ext" -eq 0 ] || overlay=$(makhzan_overlay_dir) || error 'Unsupported overlay layout'
}
apply() {
 preflight "$@"
 mkdir "$LOCK" 2>/dev/null || error 'Another storage operation is running'
 json_job "{\"state\":\"running\",\"kind\":\"prepare\",\"step\":\"checking\",\"started\":$(date +%s)}" || { rm -rf "$LOCK"; error 'Job state could not be written'; }
 makhzan_spawn /usr/libexec/makhzan-storage run "$@"
 printf '{"ok":true,"started":true}\n'
}

# ---- Filesystem check: unmount the NAS, run e2fsck, mount it again ----
svc_stop() { for svc in samba4 minidlna; do [ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc stop >/dev/null 2>&1; done; }
svc_start() { for svc in samba4 minidlna; do [ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc enabled && /etc/init.d/$svc start >/dev/null 2>&1; done; }
check_start() {
 r=$(uci -q get makhzan.main.root)
 makhzan_usb_mount "$r" || error 'USB storage is not ready'
 case "$(awk -v m="$r" '$2==m {print $3; exit}' /proc/mounts)" in ext2|ext3|ext4) ;; *) error 'Only ext2, ext3 and ext4 disks can be checked';; esac
 command -v e2fsck >/dev/null || error 'A required storage tool is missing'
 clear_stale
 mkdir "$LOCK" 2>/dev/null || error 'Another storage operation is running'
 json_job "{\"state\":\"running\",\"kind\":\"check\",\"step\":\"unmounting\",\"started\":$(date +%s)}" || { rm -rf "$LOCK"; error 'Job state could not be written'; }
 makhzan_spawn /usr/libexec/makhzan-storage run-check "$r"
 printf '{"ok":true,"started":true}\n'
}
# Whatever happens, the NAS is mounted again and the services restarted before the job ends.
check_cleanup() {
 if [ -n "$cdev" ] && ! makhzan_mounted "$croot"; then mount -t "$cfs" -o "$copts" "$cdev" "$croot" 2>/dev/null; fi
 svc_start
 rm -rf "$LOCK"
}
run_check() {
 MODE=job; KIND=check; started=$(date +%s)
 [ -d "$LOCK" ] || error 'Storage job started without its lock'
 echo $$ > "$LOCK/pid"
 croot=$1; cdev=''
 trap check_cleanup EXIT
 makhzan_usb_mount "$croot" || error 'USB storage is not ready'
 set -- $(awk -v m="$croot" '$2==m {print $1, $3, $4; exit}' /proc/mounts)
 cdev=$1; cfs=$2; copts=$3
 makhzan_usb_device "$cdev" || error 'Partition is not on a physical USB disk'
 step unmounting
 svc_stop; sync
 tries=0
 while makhzan_mounted "$croot"; do
  umount "$croot" 2>/dev/null && break
  tries=$((tries + 1)); [ "$tries" -lt 5 ] || error 'The disk is busy; close open files and try again'
  sleep 2
 done
 step checking
 log=/tmp/run/makhzan/fsck.log; mkdir -p /tmp/run/makhzan
 e2fsck -f -p "$cdev" > "$log" 2>&1; rc=$?
 # Preen mode stops on problems that need a decision; repair those automatically like a boot-time fsck -y.
 if [ $((rc & 4)) -ne 0 ]; then e2fsck -f -y "$cdev" >> "$log" 2>&1; rc=$?; fi
 if [ $((rc & 8)) -ne 0 ] || [ "$rc" -ge 16 ]; then result=failed
 elif [ $((rc & 4)) -ne 0 ]; then result=errors
 elif [ $((rc & 3)) -ne 0 ]; then result=repaired
 else result=clean; fi
 step mounting
 mount -t "$cfs" -o "$copts" "$cdev" "$croot" || error 'The disk could not be mounted again; reconnect it'
 makhzan_usb_mount "$croot" || error 'NAS USB mount verification failed'
 svc_start
 [ "$(uci -q get makhzan.main.enabled)" != 1 ] || /usr/sbin/makhzanctl apply >/dev/null 2>&1 || true
 json_job "{\"state\":\"done\",\"kind\":\"check\",\"ok\":true,\"result\":\"$result\",\"code\":$rc,\"finished\":$(date +%s)}"
}

# ---- Media library: an existing USB partition (NTFS, exFAT, FAT or ext) shared read-only ----
lib_fail() { svc_start; error "$1"; }
lib_umount() {
 tries=0
 while makhzan_mounted "$1"; do
  umount "$1" 2>/dev/null && return 0
  tries=$((tries + 1)); [ "$tries" -lt 5 ] || return 1
  sleep 1
 done
 return 0
}
lib_fstype() { case "$1" in ntfs) echo ntfs3;; exfat) echo exfat;; vfat) echo vfat;; ext2|ext3|ext4) echo "$1";; *) return 1;; esac; }
lib_package() { case "$1" in ntfs) echo kmod-fs-ntfs3;; exfat) echo kmod-fs-exfat;; vfat) echo kmod-fs-vfat;; *) echo kmod-fs-ext4;; esac; }
lib_driver() {
 grep -qw "$1" /proc/filesystems && return 0
 modprobe "$1" >/dev/null 2>&1 || insmod "$1" >/dev/null 2>&1
 grep -qw "$1" /proc/filesystems
}
# BusyBox tr has no character classes; sed strips control characters, quotes and backslashes for JSON.
lib_label() { binfo "$1" LABEL | sed 's/[[:cntrl:]"\\]//g'; }
# Partitions Makhzan itself uses (NAS, extroot, swap) are never offered as a library.
lib_reserved() {
 for sec in makhzan_nas makhzan_extroot makhzan_swap; do [ "$(uci -q get "fstab.$sec.uuid")" = "$1" ] && return 0; done
 nas_src=$(awk -v m="$(uci -q get makhzan.main.root)" '$2==m {print $1; exit}' /proc/mounts)
 [ -n "$nas_src" ] && [ "$(uuid "$nas_src")" = "$1" ]
}
library_candidates() {
 cur=$(uci -q get fstab.makhzan_library.uuid)
 printf '{"ok":true,"current":'
 if [ -n "$cur" ]; then
  printf '{"uuid":"%s","label":"%s","type":"%s","mounted":%s}' "$cur" "$(uci -q get makhzan.main.library_label | tr -d '"\\')" "$(uci -q get fstab.makhzan_library.fstype)" "$(makhzan_mounted "$LIB_TARGET" && echo true || echo false)"
 else printf null; fi
 printf ',"candidates":['; sep=''
 for sys in /sys/class/block/sd*; do
  [ -f "$sys/partition" ] || continue; dev=/dev/${sys##*/}
  makhzan_usb_device "$dev" || continue
  type=$(binfo "$dev" TYPE); fst=$(lib_fstype "$type") || continue
  u=$(binfo "$dev" UUID); [ -n "$u" ] || continue
  [ "$u" != "$cur" ] || continue
  lib_reserved "$u" && continue
  where=$(awk -v d="$dev" '$1==d {print $2; exit}' /proc/mounts)
  case "$where" in /|/overlay|/rom/overlay) continue;; esac
  drv=false; grep -qw "$fst" /proc/filesystems && drv=true
  [ "$drv" = true ] || { [ -n "$(find "/lib/modules/$(uname -r)" -name "$fst.ko" 2>/dev/null | head -n 1)" ] && drv=true; }
  printf '%s{"dev":"%s","uuid":"%s","label":"%s","type":"%s","size_mib":%s,"mounted_at":"%s","driver":%s,"package":"%s"}' "$sep" "$dev" "$u" "$(lib_label "$dev")" "$type" "$(( $(cat "$sys/size") / 2048 ))" "$where" "$drv" "$(lib_package "$type")"; sep=,
 done
 printf ']}\n'
}
library_set() {
 u=$1
 printf '%s' "$u" | grep -Eq '^[A-Za-z0-9-]{1,64}$' || error 'Partition not found'
 dev=$(block info 2>/dev/null | awk -v u="UUID=\"$u\"" 'index($0, u) {sub(/:.*/, ""); print; exit}')
 [ -n "$dev" ] && makhzan_usb_device "$dev" && [ -f "/sys/class/block/${dev#/dev/}/partition" ] || error 'Partition not found'
 lib_reserved "$u" && error 'This partition is already used by Makhzan'
 type=$(binfo "$dev" TYPE); fst=$(lib_fstype "$type") || error 'Unsupported filesystem for the media library'
 lib_driver "$fst" || error 'The kernel driver for this filesystem is not installed'
 makhzan_group || error 'Cannot create group'
 gid=$(awk -F: '$1=="makhzan" {print $3; exit}' /etc/group)
 # Read-only; FAT-family disks get group makhzan and world-readable modes so MiniDLNA can read them.
 case "$fst" in
  ntfs3|exfat) opts="ro,noatime,uid=0,gid=$gid,fmask=0133,dmask=0022";;
  vfat) opts="ro,noatime,uid=0,gid=$gid,fmask=0133,dmask=0022,utf8";;
  *) opts="ro,noatime";;
 esac
 clear_stale
 [ ! -d "$LOCK" ] || error 'Another storage operation is running'
 where=$(awk -v d="$dev" '$1==d {print $2; exit}' /proc/mounts)
 case "$where" in /|/overlay|/rom/overlay) error 'This partition is already used by Makhzan';; esac
 # Samba and MiniDLNA keep files open; stop them while the previous library and any automatic mount of
 # the chosen partition are released.
 svc_stop; sync
 lib_umount "$LIB_TARGET" || lib_fail 'A partition is still in use; close open files and retry'
 [ -z "$where" ] || [ "$where" = "$LIB_TARGET" ] || lib_umount "$where" || lib_fail 'A partition is still in use; close open files and retry' 
 uci -q delete fstab.makhzan_library
 uci set fstab.makhzan_library=mount; uci set fstab.makhzan_library.uuid="$u"; uci set fstab.makhzan_library.target="$LIB_TARGET"
 uci set fstab.makhzan_library.fstype="$fst"; uci set fstab.makhzan_library.options="$opts"; uci set fstab.makhzan_library.enabled=1
 uci commit fstab || error 'Mount configuration save failed'
 mkdir -p "$LIB_TARGET"
 mount -t "$fst" -o "$opts" "$dev" "$LIB_TARGET" || lib_fail 'The media library disk could not be mounted'
 uci set makhzan.main.library_uuid="$u"; uci set makhzan.main.library_label="$(lib_label "$dev")"; uci commit makhzan
 svc_start
 printf '{"ok":true}\n'
}
library_off() {
 if makhzan_mounted "$LIB_TARGET"; then
  svc_stop; sync
  lib_umount "$LIB_TARGET" || lib_fail 'A partition is still in use; close open files and retry'
  svc_start
 fi
 uci -q delete fstab.makhzan_library; uci commit fstab
 uci -q delete makhzan.main.library_uuid; uci -q delete makhzan.main.library_label; uci commit makhzan
 printf '{"ok":true}\n'
}
# Stop using a USB disk so it can be unplugged or re-partitioned. Active extroot cannot be released.
release() {
 dev=$1; usb "$dev" || error 'Select a whole USB disk'
 ! disk_mounts "$dev" | awk '$2=="/" || $2=="/overlay" || $2=="/rom/overlay" {f=1} END {exit !f}' || error 'This disk holds the active extroot; disable extroot and reboot first'
 clear_stale
 [ ! -d "$LOCK" ] || error 'Another storage operation is running'
 mounts=$(disk_mounts "$dev")
 if [ -n "$mounts" ]; then
  for svc in samba4 minidlna; do [ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc stop >/dev/null 2>&1; done
  sync
  echo "$mounts" | while read -r part target; do umount "$target" 2>/dev/null || umount -l "$target" 2>/dev/null; done
  for svc in samba4 minidlna; do [ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc enabled && /etc/init.d/$svc start >/dev/null 2>&1; done
 fi
 for part in $(disk_swaps "$dev"); do swapoff "$part" || error 'Swap could not be disabled'; done
 [ -z "$(disk_mounts "$dev")" ] || error 'A partition is still in use; close open files and retry'
 printf '{"ok":true}\n'
}
# Lock present without a pid file: the job is still starting. Pid recorded but gone, or a job file that
# still says "running" without a lock: the job was killed.
lock_state() {
 [ -d "$LOCK" ] || { echo none; return; }
 lock_pid=$(cat "$LOCK/pid" 2>/dev/null)
 if [ -z "$lock_pid" ] || kill -0 "$lock_pid" 2>/dev/null; then echo alive; else echo dead; fi
}
clear_stale() {
 case "$(lock_state)" in dead) rm -rf "$LOCK";; alive) return 0;; esac
 if grep -q '"state":"running"' "$JOB" 2>/dev/null; then
  json_job "{\"state\":\"failed\",\"error\":\"The disk operation was interrupted\",\"finished\":$(date +%s)}"
 fi
}
job_status() {
 clear_stale
 if [ -s "$JOB" ]; then cat "$JOB"; elif [ -d "$LOCK" ]; then echo '{"state":"running"}'; else echo '{"state":"idle"}'; fi
}
# Serialize disk changes with the downloader's dispatch. No new transfer can start between
# this check and creation of the storage-operation lock (or the end of a release).
case "$1" in apply|check|release)
 lock /var/lock/makhzan-download.lock || error 'Could not lock downloader'
 trap 'lock -u /var/lock/makhzan-download.lock' EXIT
 for df in /tmp/run/makhzan-download/worker.*; do
 dp=$(cat "$df" 2>/dev/null)
 case "$dp" in ''|*[!0-9]*) ;; *)
  if kill -0 "$dp" 2>/dev/null && tr '\000' ' ' < "/proc/$dp/cmdline" 2>/dev/null | grep -q '/usr/libexec/makhzan-download worker '; then
   error 'Pause the active download before changing the disk'
  fi;;
 esac
 done;;
esac
case "$1" in
 devices) devices;;
 plan) plan "$2" "$3" "$4" "$5"; plan_json;;
 apply) apply "$2" "$3" "$4" "$5" "$6";;
 run) shift; run "$@";;
 release) release "$2";;
 job) job_status;;
 check) check_start;;
 run-check) run_check "$2";;
 library-list) library_candidates;;
 library-set) library_set "$2";;
 library-off) library_off;;
 *) error 'Unknown storage action';;
esac
