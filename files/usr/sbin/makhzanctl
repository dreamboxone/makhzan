#!/bin/sh
# Makhzan - USB NAS manager for OpenWrt
# Copyright (C) 2026 dreamboxone
# SPDX-License-Identifier: GPL-3.0-only
#
# This program is free software: you can redistribute it and/or modify it under the terms
# of the GNU General Public License version 3 as published by the Free Software Foundation.
# It is distributed WITHOUT ANY WARRANTY; see the LICENSE file for details.
# Makhzan NAS control plane. Input is intentionally narrow: UI text is never evaluated by a shell.
# Passwords never travel on the command line: the LuCI page writes a one-time 0600 file
# SECRET_DIR/secret.<32 hex> (rpcd refuses exec environments for sessions) and passes only the token;
# root shell users may set MAKHZAN_PASSWORD instead.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
. /usr/libexec/makhzan-usb.sh || exit 1

VERSION=1.2.0
SMB_TEMPLATE=/etc/samba/smb.conf.template
CONTROL_LOCK=/var/lock/makhzan-control.lock
SECRET_DIR=/tmp/run/makhzan
USAGE_FILE=$SECRET_DIR/usage.json
USAGE_LOCK=$SECRET_DIR/usage.lock
USAGE_MAX_AGE=300
LIB_TARGET=/mnt/makhzan-library
RESERVED='shared media library homes global printers print$ ipc$ root admin'

quote() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'; }
ok() { printf '{"ok":true%s}\n' "$1"; }
fail() { printf '{"ok":false,"error":"%s"}\n' "$(quote "$1")"; return 1; }
bool() { [ "$1" = 1 ] && echo true || echo false; }
# BusyBox tr on OpenWrt has no character classes; match raw control bytes instead (UTF-8 text passes).
no_cntrl() {
	[ "$(printf '%s' "$1" | wc -l)" -eq 0 ] || return 1
	! printf '%s' "$1" | grep -q "$(printf '[\001-\037\177]')"
}
valid_user() {
	printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,30}$' && [ "$(printf '%s' "$1" | wc -l)" -eq 0 ] || return 1
	for word in $RESERVED; do [ "$1" != "$word" ] || return 1; done
}
# One folder name: no path separators, no Windows-reserved characters, no control characters, at most 255 bytes.
valid_name() {
	[ -n "$1" ] && [ "$(printf '%s' "$1" | wc -c)" -le 255 ] || return 1
	case "$1" in *[/\\:*?\"\<\>\|]*|' '*|*' '|*.) return 1;; esac
	no_cntrl "$1"
}
# Reads (and always deletes) the one-time password file for TOKEN; falls back to MAKHZAN_PASSWORD.
read_password() {
	pw=''
	if [ -n "$1" ]; then
		printf '%s' "$1" | grep -Eq '^[0-9a-f]{32}$' && [ "$(printf '%s' "$1" | wc -l)" -eq 0 ] || return 1
		f="$SECRET_DIR/secret.$1"
		[ -f "$f" ] && [ ! -L "$f" ] || return 1
		set -- $(ls -ln "$f" | awk '{print $1, $3}')
		pw=$(cat "$f"); rm -f "$f"
		[ "$1" = -rw------- ] && [ "$2" = 0 ] || { pw=''; return 1; }
	else
		pw=$MAKHZAN_PASSWORD
	fi
	return 0
}
secret_dir() {
	[ -d "$SECRET_DIR" ] && [ ! -L "$SECRET_DIR" ] || mkdir -m 0700 -p "$SECRET_DIR"
	chmod 0700 "$SECRET_DIR" 2>/dev/null
	# One-time files are consumed immediately; anything older than a minute is abandoned.
	find "$SECRET_DIR" -maxdepth 1 -type f -name 'secret.*' -mmin +1 -exec rm -f {} \; 2>/dev/null
}
valid_password() {
	[ "$(printf '%s' "$1" | wc -c)" -ge 8 ] && [ "$(printf '%s' "$1" | wc -c)" -le 64 ] && no_cntrl "$1"
}

control_lock() {
	if ! mkdir "$CONTROL_LOCK" 2>/dev/null; then
		holder=$(cat "$CONTROL_LOCK/pid" 2>/dev/null)
		if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then fail 'Another operation is running; wait until it completes'; exit 1; fi
		rm -rf "$CONTROL_LOCK"; mkdir "$CONTROL_LOCK" 2>/dev/null || { fail 'Another operation is running; wait until it completes'; exit 1; }
	fi
	echo $$ > "$CONTROL_LOCK/pid"
	trap 'rm -rf "$CONTROL_LOCK"' EXIT
}

root() { uci -q get makhzan.main.root; }
valid_root() {
	r=$(root)
	case "$r" in /mnt/*|/srv/*) ;; *) return 1;; esac
	[ "$(readlink -f "$r")" = "$r" ] && [ -d "$r" ] && [ ! -L "$r" ] && makhzan_mounted "$r" || return 1
	makhzan_usb_mount "$r"
}
# The NAS partition may be unmounted (hot-plug timing, or block-mount being reinstalled); mount it from fstab.
root_remount() {
	valid_root && return 0
	[ "$(uci -q get fstab.makhzan_nas.enabled)" = 1 ] && [ "$(uci -q get fstab.makhzan_nas.target)" = "$(root)" ] || return 1
	command -v block >/dev/null && block mount >/dev/null 2>&1
	valid_root
}
ensure_layout() {
	root_remount || { fail 'USB storage is not ready: select a mounted USB ext4 disk'; return 1; }
	makhzan_layout "$(root)" || { fail 'Unsafe storage layout'; return 1; }
}
# Reconnect only the saved NAS on page load. Do not run this from status polling: a disk released by
# the administrator must stay released. After removal, fstab retains its UUID and custom mount path.
storage_ready() {
	if ! valid_root; then
		[ "$(uci -q get fstab.makhzan_nas.enabled)" = 1 ] || { ok ',"root":""'; return; }
		r=$(uci -q get fstab.makhzan_nas.target)
		case "$r" in /mnt/*|/srv/*) ;; *) ok ',"root":""'; return;; esac
		[ "$(readlink -f "$r")" = "$r" ] && [ ! -L "$r" ] || { ok ',"root":""'; return; }
		if ! makhzan_usb_mount "$r"; then
			# Verify the saved UUID belongs to a physical USB device before attempting its mount.
			saved_uuid=$(uci -q get fstab.makhzan_nas.uuid)
			[ -n "$saved_uuid" ] || { ok ',"root":""'; return; }
			saved_dev=$(block info 2>/dev/null | awk -v id="$saved_uuid" 'index($0, " UUID=\"" id "\"") {sub(/:$/, "", $1); print $1; exit}')
			makhzan_usb_device "$saved_dev" || { ok ',"root":""'; return; }
			block mount >/dev/null 2>&1
			makhzan_usb_mount "$r" || { ok ',"root":""'; return; }
		fi
	fi
	makhzan_layout "$r" || { fail 'Unsafe storage layout'; return; }
	[ "$(root)" = "$r" ] || { uci set makhzan.main.root="$r"; uci commit makhzan; }
	ok ",\"root\":\"$(quote "$r")\""
}
# The read-only media library disk is used only while it is mounted from a physical USB partition.
library_ready() {
	src=$(awk -v m="$LIB_TARGET" '$2==m {print $1; exit}' /proc/mounts)
	[ -n "$src" ] && makhzan_usb_device "$src"
}

# ---- Space usage: du walks every file, so sizes are cached and refreshed in the background at most every
# five minutes instead of on every status poll (this also lets idle hard disks spin down). ----
usage_scan() {
	if ! mkdir "$USAGE_LOCK" 2>/dev/null; then
		holder=$(cat "$USAGE_LOCK/pid" 2>/dev/null)
		[ -n "$holder" ] && kill -0 "$holder" 2>/dev/null && return 0
		rm -rf "$USAGE_LOCK"; mkdir "$USAGE_LOCK" 2>/dev/null || return 0
	fi
	echo $$ > "$USAGE_LOCK/pid"
	trap 'rm -rf "$USAGE_LOCK"' EXIT
	valid_root || return 0
	r=$(root); list=''
	for u in $(managed_users); do
		valid_home "$u" || continue
		k=$(du -sk "$(home_of "$u")" 2>/dev/null | awk '{print $1}')
		list="$list${list:+,}\"$u\":${k:-0}"
	done
	dir_kib() { k=0; [ ! -d "$1" ] || [ -L "$1" ] || k=$(du -sk "$1" 2>/dev/null | awk '{print $1}'); echo "${k:-0}"; }
	printf '{"time":%s,"root":"%s","users":{%s},"shared_kib":%s,"media_kib":%s,"trash_kib":%s}\n' \
		"$(date +%s)" "$(quote "$r")" "$list" "$(dir_kib "$r/shared")" "$(dir_kib "$r/media")" "$(dir_kib "$r/.makhzan-trash")" > "$USAGE_FILE.tmp" &&
	mv -f "$USAGE_FILE.tmp" "$USAGE_FILE"
}
usage_refresh() { makhzan_spawn /usr/sbin/makhzanctl usage-scan; }

# ---- Accounts: Makhzan-managed accounts have GECOS "makhzan", uid >= 1000 and shell /bin/false ----
managed_user() { awk -F: -v u="$1" '$1==u && $3>=1000 && $5=="makhzan" && $7=="/bin/false" {f=1} END {exit !f}' /etc/passwd; }
user_uid() { awk -F: -v u="$1" '$1==u {print $3; exit}' /etc/passwd; }
managed_users() { awk -F: '$3>=1000 && $5=="makhzan" && $7=="/bin/false" {print $1}' /etc/passwd; }
account_create() {
	gid=$(awk -F: '$1=="makhzan" {print $3; exit}' /etc/group); [ -n "$gid" ] || return 1
	lock /var/lock/passwd
	uid=$(awk -F: '{u[$3]=1} END {for (i=1000; i<30000; i++) if (!(i in u)) {print i; exit}}' /etc/passwd)
	rc=1
	if [ -n "$uid" ]; then
		echo "$1:x:$uid:$gid:makhzan:/var/empty:/bin/false" >> /etc/passwd && rc=0
		[ ! -f /etc/shadow ] || echo "$1:!:0:0:99999:7:::" >> /etc/shadow || rc=1
	fi
	lock -u /var/lock/passwd
	return $rc
}
account_remove() {
	managed_user "$1" || return 1
	lock /var/lock/passwd
	sed -i "/^$1:/d" /etc/passwd; [ ! -f /etc/shadow ] || sed -i "/^$1:/d" /etc/shadow
	lock -u /var/lock/passwd
}
home_of() { echo "$(root)/users/$1"; }
# The home must be a real directory on the NAS, owned by the user and private (mode 0700).
valid_home() {
	h=$(home_of "$1"); makhzan_same_fs "$(root)" "$h" || return 1
	set -- $(makhzan_owner_mode "$h") "$(user_uid "$1")"
	[ "$1" = drwx------ ] && [ "$2" = "$3" ]
}

# ---- Read-only users: they read Shared and Media but cannot change them; their private folder stays theirs ----
readonly_list() { uci -q get makhzan.main.readonly; }
is_readonly() { for x in $(readonly_list); do [ "$x" = "$1" ] && return 0; done; return 1; }

# ---- Time Machine needs Samba's fruit and streams_xattr modules ----
tm_supported() { [ -f /usr/lib/samba/vfs/fruit.so ] && [ -f /usr/lib/samba/vfs/streams_xattr.so ]; }
# macOS mode is global in Samba; Makhzan remembers when it switched it on so it can switch it off again.
tm_macos() {
	if [ "$(uci -q get makhzan.main.timemachine)" = 1 ] && tm_supported; then
		if [ "$(uci -q get samba4.@samba[0].macos)" != 1 ]; then
			uci set samba4.@samba[0].macos=1; uci set makhzan.main.tm_macos=1; uci commit makhzan
		fi
	elif [ "$(uci -q get makhzan.main.tm_macos)" = 1 ]; then
		uci set samba4.@samba[0].macos=0; uci -q delete makhzan.main.tm_macos; uci commit makhzan
	fi
}

# ---- Spin-down of mechanical USB disks through hd-idle; the disk name is refreshed on every apply ----
spindown_supported() { [ -f /etc/config/hd-idle ] && [ -x /etc/init.d/hd-idle ]; }
spindown_apply() {
	spindown_supported || return 0
	m=$(uci -q get makhzan.main.spindown); case "$m" in ''|*[!0-9]*) m=0;; esac
	disk=''; src=$(awk -v mp="$(root)" '$2==mp {print $1; exit}' /proc/mounts)
	if [ -n "$src" ]; then
		disk=${src#/dev/}
		[ ! -f "/sys/class/block/$disk/partition" ] || disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/$disk")")")
	fi
	uci -q delete hd-idle.makhzan
	if [ "$m" -gt 0 ] && [ -n "$disk" ]; then
		uci set hd-idle.makhzan=hd-idle; uci set hd-idle.makhzan.disk="$disk"; uci set hd-idle.makhzan.enabled=1
		uci set hd-idle.makhzan.idle_time_unit=minutes; uci set hd-idle.makhzan.idle_time_interval="$m"
	fi
	uci commit hd-idle
	[ "$m" -eq 0 ] || /etc/init.d/hd-idle enable >/dev/null 2>&1
	/etc/init.d/hd-idle restart >/dev/null 2>&1
	return 0
}

# ---- Samba ----
smb_installed() { command -v smbd >/dev/null && command -v smbpasswd >/dev/null && command -v pdbedit >/dev/null && [ -f /etc/config/samba4 ]; }
# Samba settings Makhzan needs, appended to the [global] template as marked lines (the last value wins):
# tdbsam stores bad-password counters (lockout), access-based enumeration hides other users' private shares,
# disabling SMB1 unix extensions prevents clients from creating symlinks, and rejecting unknown accounts
# (instead of OpenWrt's guest mapping) makes Windows show its password prompt rather than a guest failure.
SMB_SETTINGS='passdb backend = tdbsam|access based share enum = yes|unix extensions = no|map to guest = Never'
smb_template_on() {
	[ -f "$SMB_TEMPLATE" ] || return 1
	changed=0
	IFS='|'; set -- $SMB_SETTINGS; unset IFS
	for setting in "$@"; do
		grep -q "^[[:space:]]*$setting[[:space:]]*\$" "$SMB_TEMPLATE" && continue
		case "$setting" in passdb*)
			# Carry existing smbpasswd accounts over; tdbsam keeps them from now on.
			pdbedit -i smbpasswd:/etc/samba/smbpasswd -e tdbsam:/etc/samba/passdb.tdb >/dev/null 2>&1;;
		esac
		printf '\t## makhzan-managed\n\t%s\n' "$setting" >> "$SMB_TEMPLATE" || return 1
		changed=1
	done
	# Regenerate smb.conf now so smbpasswd/pdbedit use tdbsam immediately.
	[ "$changed" = 0 ] || smb_restart
}
# Drop Makhzan's settings from the template. tdbsam stays unless "all" is given: accounts created under
# tdbsam cannot be exported back to the smbpasswd format, so it is only reverted when no accounts remain.
smb_template_off() {
	[ -f "$SMB_TEMPLATE" ] || return 0
	awk -v all="$1" '
		/## makhzan-managed/ { marker=$0; next }
		marker != "" { if (all == "" && $0 ~ /passdb backend = tdbsam/) { print marker; print } marker=""; next }
		{ print }
	' "$SMB_TEMPLATE" > "$SMB_TEMPLATE.makhzan" && mv -f "$SMB_TEMPLATE.makhzan" "$SMB_TEMPLATE"
}
# Four failed SMB logins lock an account for 15 minutes. Samba keeps the policy in RAM, so it is re-applied at boot.
smb_policy() {
	pdbedit -P 'bad lockout attempt' -C 4 >/dev/null 2>&1 &&
	pdbedit -P 'lockout duration' -C 15 >/dev/null 2>&1 &&
	pdbedit -P 'reset count minutes' -C 15 >/dev/null 2>&1
}
smb_share() {
	s=$(uci add samba4 sambashare) || return 1
	uci set "samba4.$s.makhzan=1"; uci set "samba4.$s.name=$1"; uci set "samba4.$s.path=$2"; uci set "samba4.$s.users=$3"
	uci set "samba4.$s.create_mask=$4"; uci set "samba4.$s.dir_mask=$5"
	uci set "samba4.$s.read_only=no"; uci set "samba4.$s.guest_ok=no"; uci set "samba4.$s.browseable=yes"; uci set "samba4.$s.inherit_owner=no"
}
smb_clear() {
	uci -q delete samba4.makhzan_shared
	i=$(uci -q show samba4 | grep -c '=sambashare$')
	while [ "$i" -gt 0 ]; do
		i=$((i - 1)); [ "$(uci -q get "samba4.@sambashare[$i].makhzan")" != 1 ] || uci -q delete "samba4.@sambashare[$i]"
	done
}
smb_restart() {
	/etc/init.d/samba4 enable >/dev/null 2>&1
	/etc/init.d/samba4 restart >/dev/null 2>&1 || return 1
	[ -e /etc/samba/smb.conf ] || return 1
	tries=0; while [ "$tries" -lt 10 ] && ! pidof smbd >/dev/null; do sleep 1; tries=$((tries + 1)); done
	smb_policy
}
smb_sync() {
	smb_installed || return 0
	had=$(uci -q show samba4 | grep -c '\.makhzan=.1.$')
	smb_clear
	if [ "$(uci -q get makhzan.main.samba)" = 1 ] && valid_root; then
		smb_template_on || return 1
		r=$(root)
		ro=''; for u in $(readonly_list); do managed_user "$u" && ro="$ro${ro:+ }$u"; done
		smb_share Shared "$r/shared" @makhzan 0660 0770; [ -z "$ro" ] || uci set "samba4.$s.read_list=$ro"
		smb_share Media "$r/media" @makhzan 0664 0775; [ -z "$ro" ] || uci set "samba4.$s.read_list=$ro"
		if library_ready; then smb_share Library "$LIB_TARGET" @makhzan 0644 0755; uci set "samba4.$s.read_only=yes"; fi
		tm=0; [ "$(uci -q get makhzan.main.timemachine)" = 1 ] && tm_supported && tm=1
		tmgb=$(uci -q get makhzan.main.timemachine_gb); case "$tmgb" in ''|*[!0-9]*) tmgb=0;; esac
		for u in $(managed_users); do
			valid_home "$u" || continue
			smb_share "$u" "$(home_of "$u")" "$u" 0600 0700
			# Each Mac backs up into its owner's private share, so backups stay private.
			if [ "$tm" = 1 ]; then uci set "samba4.$s.timemachine=1"; [ "$tmgb" -eq 0 ] || uci set "samba4.$s.timemachine_maxsize=$tmgb"; fi
		done
		tm_macos
		uci commit samba4 || return 1
		smb_restart
	else
		# SMB disabled in Makhzan: remove our shares but never enable a Samba service the administrator disabled.
		uci commit samba4 || return 1
		[ "$had" -eq 0 ] || ! pidof smbd >/dev/null || /etc/init.d/samba4 restart >/dev/null 2>&1
		return 0
	fi
}
smb_required() {
	smb_installed || { fail 'samba4-server is not installed'; return 1; }
	[ "$(uci -q get makhzan.main.samba)" = 1 ] || { fail 'Enable SMB and apply service settings first'; return 1; }
	smb_template_on || { fail 'Samba template could not be prepared'; return 1; }
}
smb_flags() { pdbedit -L -w 2>/dev/null | awk -F: -v u="$1" '$1==u {print $5; exit}'; }
smb_password() { printf '%s\n%s\n' "$2" "$2" | smbpasswd -s $3 "$1" >/dev/null 2>&1; }

# ---- Extroot ----
# UUID of the Makhzan extroot partition if the running system booted from it, else empty.
extroot_active_uuid() {
	want=$(uci -q get fstab.makhzan_extroot.uuid); [ -n "$want" ] || return 0
	for mp in /overlay /rom/overlay; do
		src=$(awk -v m="$mp" '$2==m && $3!="overlay" {print $1; exit}' /proc/mounts)
		[ -n "$src" ] || continue
		[ "$(block info "$src" 2>/dev/null | sed -n 's/.* UUID="\([^"]*\)".*/\1/p')" = "$want" ] && { echo "$want"; return 0; }
	done
}
# Turning extroot off must edit the fstab of the internal storage. While extroot is active that fstab
# is not reachable in a portable way, so the router has to be started without the USB disk first.
extroot_off() {
	[ "$(uci -q get fstab.makhzan_extroot.enabled)" = 1 ] || { ok; return; }
	[ -z "$(extroot_active_uuid)" ] || { fail 'Extroot is active: power off, unplug the USB disk, power on, then turn extroot off'; return; }
	uci set fstab.makhzan_extroot.enabled=0 && uci commit fstab || { fail 'Mount configuration save failed'; return; }
	uci -q delete makhzan.main.storage_extroot_uuid; uci -q delete makhzan.main.storage_boot; uci commit makhzan
	ok
}

# ---- Status ----
status() {
	language=$(uci -q get makhzan.main.language); [ "$language" = en ] || language=fa
	# Extroot: off | pending (prepared in this boot, reboot needed) | active | inactive (configured but the
	# router did not boot from it: USB missing or activation failed). The overlay is /overlay or, on
	# loop-backed targets, /rom/overlay.
	extroot_state=off
	if [ "$(uci -q get fstab.makhzan_extroot.enabled)" = 1 ]; then
		if [ -n "$(extroot_active_uuid)" ]; then extroot_state=active
		elif [ "$(uci -q get makhzan.main.storage_boot)" = "$(cat /proc/sys/kernel/random/boot_id)" ]; then extroot_state=pending
		else extroot_state=inactive; fi
	fi
	reboot=false; [ "$extroot_state" != pending ] || reboot=true
	extroot=false; [ "$extroot_state" != active ] || extroot=true
	r=$(root); disk=null; ready=false; users=''; usage=null; umap=''
	if valid_root; then
		ready=true
		set -- $(df -Pk "$r" 2>/dev/null | awk 'NR==2 {print $2, $3, $4}')
		fs=$(awk -v m="$r" '$2==m {print $3; exit}' /proc/mounts)
		disk=$(printf '{"root":"%s","filesystem":"%s","total_kib":%s,"used_kib":%s,"available_kib":%s}' "$(quote "$r")" "$(quote "$fs")" "${1:-0}" "${2:-0}" "${3:-0}")
		if [ -s "$USAGE_FILE" ] && grep -qF "\"root\":\"$(quote "$r")\"" "$USAGE_FILE"; then
			usage=$(cat "$USAGE_FILE")
			t=$(sed -n 's/^{"time":\([0-9]*\),.*/\1/p' "$USAGE_FILE"); age=$(( $(date +%s) - ${t:-0} ))
			[ "$age" -ge 0 ] && [ "$age" -lt "$USAGE_MAX_AGE" ] || usage_refresh
			umap=$(printf '%s' "$usage" | sed -n 's/.*"users":{\([^}]*\)}.*/\1/p' | tr ',' '\n')
		else
			usage_refresh
		fi
	fi
	smb_users=''; smb_installed && smb_users=$(pdbedit -L -w 2>/dev/null | awk -F: '{print $1 ":" $5}')
	for u in $(managed_users); do
		used=-1; home=false
		if [ "$ready" = true ] && valid_home "$u"; then home=true; used=$(printf '%s\n' "$umap" | sed -n "s/^\"$u\"://p"); fi
		flags=$(printf '%s\n' "$smb_users" | awk -F: -v u="$u" '$1==u {print $2; exit}')
		smb=false; locked=false; [ -z "$flags" ] || smb=true
		case "$flags" in *L*) locked=true;; esac
		ro=false; is_readonly "$u" && ro=true
		users="$users${users:+,}{\"name\":\"$(quote "$u")\",\"home\":$home,\"used_kib\":${used:--1},\"smb\":$smb,\"locked\":$locked,\"readonly\":$ro}"
	done
	library=null
	if library_ready; then
		set -- $(df -Pk "$LIB_TARGET" 2>/dev/null | awk 'NR==2 {print $2, $3}')
		library=$(printf '{"label":"%s","type":"%s","total_kib":%s,"used_kib":%s}' "$(uci -q get makhzan.main.library_label | sed 's/["\\]//g')" "$(awk -v m="$LIB_TARGET" '$2==m {print $3; exit}' /proc/mounts)" "${1:-0}" "${2:-0}")
	fi
	tmgb=$(uci -q get makhzan.main.timemachine_gb); case "$tmgb" in ''|*[!0-9]*) tmgb=0;; esac
	spin=$(uci -q get makhzan.main.spindown); case "$spin" in ''|*[!0-9]*) spin=0;; esac
	smbd_running=false; pidof smbd >/dev/null && smbd_running=true
	dlna_running=false; pidof minidlnad >/dev/null && dlna_running=true
	job=$(/usr/libexec/makhzan-storage job)
	printf '{"version":"%s","language":"%s","reboot_required":%s,"extroot_active":%s,"extroot_state":"'"$extroot_state"'","ready":%s,"disk":%s,"usage":%s,"library":%s,"users":[%s],"job":%s,"services":{"samba_installed":%s,"minidlna_installed":%s,"samba_enabled":%s,"dlna_enabled":%s,"samba_running":%s,"dlna_running":%s,"timemachine_supported":%s,"timemachine_enabled":%s,"timemachine_gb":%s,"spindown_supported":%s,"spindown_minutes":%s}}\n' \
		"$VERSION" "$language" "$reboot" "$extroot" "$ready" "$disk" "$usage" "$library" "$users" "$job" \
		"$(smb_installed && echo true || echo false)" "$(command -v minidlnad >/dev/null && echo true || echo false)" \
		"$(bool "$(uci -q get makhzan.main.samba)")" "$(bool "$(uci -q get makhzan.main.dlna)")" "$smbd_running" "$dlna_running" \
		"$(tm_supported && echo true || echo false)" "$(bool "$(uci -q get makhzan.main.timemachine)")" "$tmgb" \
		"$(spindown_supported && echo true || echo false)" "$spin"
}

# ---- Commands ----
set_root() {
	p=$1; case "$p" in /mnt/*|/srv/*) ;; *) fail 'Storage root must be below /mnt or /srv'; return;; esac
	[ "$(readlink -f "$p")" = "$p" ] && [ -d "$p" ] && [ ! -L "$p" ] && makhzan_mounted "$p" || { fail 'Selected path is not an existing canonical mount point'; return; }
	makhzan_usb_mount "$p" || { fail 'Only a mounted USB flash drive or USB hard disk with ext2/3/4, btrfs or xfs is allowed'; return; }
	uci set makhzan.main.root="$p"; uci commit makhzan
	ensure_layout || return
	smb_sync || { fail 'Samba configuration or restart failed'; return; }
	ok
}
add_user() {
	u=$1
	read_password "$2" || { fail 'Password transfer failed; try again'; return; }
	valid_user "$u" || { fail 'Username must be 1-31 lowercase letters, numbers, _ or -, and not a reserved share name'; return; }
	grep -q "^$u:" /etc/passwd && { fail 'This username already exists on the router'; return; }
	valid_password "$pw" || { fail 'Password must be 8-64 characters without control characters'; return; }
	ensure_layout || return
	smb_required || return
	account_create "$u" || { fail 'Unable to create local account'; return; }
	h=$(home_of "$u")
	if [ -e "$h" ] || [ -L "$h" ] || ! mkdir -m 0700 "$h" || ! chown -h "$u:makhzan" "$h"; then
		account_remove "$u"; fail 'Unable to create the private folder (a folder with this name may already exist)'; return
	fi
	if ! smb_password "$u" "$pw" -a; then
		rmdir "$h" 2>/dev/null; account_remove "$u"; fail 'Samba password could not be set'; return
	fi
	if [ "$3" = ro ]; then uci add_list makhzan.main.readonly="$u"; uci commit makhzan; fi
	smb_sync || { fail 'User created, but Samba restart failed'; return; }
	usage_refresh
	ok
}
set_access() {
	u=$1; managed_user "$u" || { fail 'Unknown Makhzan user'; return; }
	case "$2" in
		ro) is_readonly "$u" || uci add_list makhzan.main.readonly="$u";;
		rw) uci -q del_list makhzan.main.readonly="$u";;
		*) fail 'Invalid option'; return;;
	esac
	uci commit makhzan
	smb_sync || { fail 'Samba configuration or restart failed'; return; }
	ok
}
set_password() {
	u=$1
	read_password "$2" || { fail 'Password transfer failed; try again'; return; }
	managed_user "$u" || { fail 'Unknown Makhzan user'; return; }
	valid_password "$pw" || { fail 'Password must be 8-64 characters without control characters'; return; }
	smb_required || return
	if [ -n "$(smb_flags "$u")" ]; then smb_password "$u" "$pw" || { fail 'Samba password could not be changed'; return; }
	else smb_password "$u" "$pw" -a || { fail 'Samba password could not be set'; return; }; fi
	unlock_user "$u" >/dev/null
	ok
}
unlock_user() {
	u=$1; managed_user "$u" || { fail 'Unknown Makhzan user'; return; }
	smb_required || return
	pdbedit -u "$u" -z >/dev/null 2>&1
	flags=$(smb_flags "$u")
	# pdbedit -c sets exactly the given [NDHLX] flags; resend the current ones without L.
	case "$flags" in *L*) pdbedit -r -u "$u" -c "[$(printf '%s' "$flags" | sed 's/[^NDHX]//g')]" >/dev/null 2>&1;; esac
	case "$(smb_flags "$u")" in *L*) fail 'Account could not be unlocked'; return;; esac
	ok
}
del_user() {
	u=$1; managed_user "$u" || { fail 'Unknown Makhzan user'; return; }
	ensure_layout || return
	r=$(root); h=$(home_of "$u")
	if [ -e "$h" ] || [ -L "$h" ]; then
		makhzan_same_fs "$r" "$h" || { fail 'Private folder is not a regular NAS folder'; return; }
		mkdir -p -m 0700 "$r/.makhzan-trash/$u" && makhzan_same_fs "$r" "$r/.makhzan-trash/$u" || { fail 'Recovery trash is unavailable'; return; }
		# ":" never occurs in folder names, so a deleted home cannot be mistaken for a trashed folder.
		mv -n -T "$h" "$r/.makhzan-trash/$u/home:$(date +%Y%m%d-%H%M%S).$$" || { fail 'Private folder could not be moved to recovery trash'; return; }
	fi
	smb_installed && smbpasswd -x "$u" >/dev/null 2>&1
	account_remove "$u" || { fail 'Account could not be removed'; return; }
	uci -q del_list makhzan.main.readonly="$u"; uci commit makhzan
	[ ! -x /usr/libexec/makhzan-remote ] || /usr/libexec/makhzan-remote remove "$u" >/dev/null 2>&1
	smb_sync || { fail 'User removed, but Samba restart failed'; return; }
	usage_refresh
	ok
}
folder_prepare() {
	valid_root || { fail 'USB storage is not ready'; return 1; }
	managed_user "$1" || { fail 'Unknown Makhzan user'; return 1; }
	valid_home "$1" || { fail 'Private folder is missing or unsafe'; return 1; }
	h=$(home_of "$1")
}
list_folders() {
	folder_prepare "$1" || return
	out=''
	for d in "$h"/* "$h"/.[!.]* "$h"/..?*; do
		[ -d "$d" ] && [ ! -L "$d" ] || continue
		n=${d##*/}; no_cntrl "$n" || continue
		out="$out${out:+,}\"$(quote "$n")\""
	done
	ok ",\"folders\":[$out]"
}
make_folder() {
	folder_prepare "$1" || return
	valid_name "$2" || { fail 'Invalid folder name'; return; }
	[ ! -e "$h/$2" ] && [ ! -L "$h/$2" ] || { fail 'A file or folder with this name already exists'; return; }
	mkdir -m 0700 "$h/$2" && chown -h "$1:makhzan" "$h/$2" || { fail 'Folder could not be created'; return; }
	ok
}
rename_folder() {
	folder_prepare "$1" || return
	valid_name "$2" && valid_name "$3" || { fail 'Invalid folder name'; return; }
	[ -d "$h/$2" ] && [ ! -L "$h/$2" ] || { fail 'Folder not found'; return; }
	[ ! -e "$h/$3" ] && [ ! -L "$h/$3" ] || { fail 'A file or folder with the new name already exists'; return; }
	mv -n -T "$h/$2" "$h/$3" && [ -d "$h/$3" ] && [ ! -e "$h/$2" ] || { fail 'Folder could not be renamed'; return; }
	ok
}
trash_folder() {
	folder_prepare "$1" || return
	valid_name "$2" || { fail 'Invalid folder name'; return; }
	[ -d "$h/$2" ] && [ ! -L "$h/$2" ] || { fail 'Folder not found'; return; }
	r=$(root); t="$r/.makhzan-trash/$1"
	mkdir -p -m 0700 "$t" && makhzan_same_fs "$r" "$t" || { fail 'Recovery trash is unavailable'; return; }
	mv -n -T "$h/$2" "$t/$2.$(date +%Y%m%d-%H%M%S).$$" || { fail 'Folder could not be moved to trash'; return; }
	ok
}
empty_trash() {
	ensure_layout || return
	t="$(root)/.makhzan-trash"
	for d in "$t"/* "$t"/.[!.]* "$t"/..?*; do [ -e "$d" ] || [ -L "$d" ] || continue; rm -rf "$d" || { fail 'Trash could not be emptied'; return; }; done
	usage_refresh
	ok
}
# Trash entries are TRASH/<user>/<name>.<YYYYmmdd-HHMMSS>.<pid>; deleted homes are home:<stamp>.<pid>
# (older releases used home.<stamp>.<pid>).
trash_kind() {
	case "$1" in home:*) echo home;; *) printf '%s' "$1" | grep -Eq '^home\.[0-9]{8}-[0-9]{6}\.[0-9]+$' && echo home || echo folder;; esac
}
trash_name() { printf '%s' "$1" | sed 's/\.[0-9]\{8\}-[0-9]\{6\}\.[0-9]\{1,\}$//'; }
trash_stamp() { printf '%s' "$1" | sed -n 's/.*[.:]\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)-\([0-9]\{2\}\)\([0-9]\{2\}\)[0-9]\{2\}\.[0-9]\{1,\}$/\1-\2-\3 \4:\5/p'; }
trash_list() {
	valid_root || { fail 'USB storage is not ready'; return; }
	t="$(root)/.makhzan-trash"; out=''
	for ud in "$t"/*; do
		[ -d "$ud" ] && [ ! -L "$ud" ] || continue
		u=${ud##*/}; printf '%s' "$u" | grep -Eq '^[a-z][a-z0-9_-]{0,30}$' || continue
		for e in "$ud"/* "$ud"/.[!.]* "$ud"/..?*; do
			[ -d "$e" ] && [ ! -L "$e" ] || continue
			n=${e##*/}; no_cntrl "$n" || continue
			kind=$(trash_kind "$n"); name=$(trash_name "$n"); [ "$kind" = folder ] || name=''
			k=$(timeout 10 du -sk "$e" 2>/dev/null | awk '{print $1}')
			out="$out${out:+,}{\"user\":\"$u\",\"entry\":\"$(quote "$n")\",\"name\":\"$(quote "$name")\",\"kind\":\"$kind\",\"deleted\":\"$(trash_stamp "$n")\",\"size_kib\":${k:--1}}"
		done
	done
	ok ",\"items\":[$out]"
}
# Validates USER and ENTRY and sets src to the trash entry.
trash_entry() {
	valid_root || { fail 'USB storage is not ready'; return 1; }
	printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,30}$' && [ -n "$2" ] && no_cntrl "$2" || { fail 'Trash item not found'; return 1; }
	case "$2" in */*|.|..) fail 'Trash item not found'; return 1;; esac
	r=$(root); src="$r/.makhzan-trash/$1/$2"
	makhzan_same_fs "$r" "$src" || { fail 'Trash item not found'; return 1; }
}
trash_restore() {
	trash_entry "$1" "$2" || return
	managed_user "$1" && valid_home "$1" || { fail 'The owner of this item no longer exists; create a user with the same name first'; return; }
	h=$(home_of "$1")
	if [ "$(trash_kind "$2")" = home ]; then base="Recovered $(trash_stamp "$2" | cut -d' ' -f1)"; else base=$(trash_name "$2"); fi
	valid_name "$base" || base='Recovered'
	dest="$h/$base"; i=2
	while [ -e "$dest" ] || [ -L "$dest" ]; do dest="$h/$base ($i)"; i=$((i + 1)); done
	mv -n -T "$src" "$dest" || { fail 'The item could not be restored'; return; }
	# The owner may have been recreated with a new uid; hand everything back to the current account.
	chown -R -h "$1:makhzan" "$dest"
	rmdir "$r/.makhzan-trash/$1" 2>/dev/null
	usage_refresh
	ok ",\"restored\":\"$(quote "${dest##*/}")\""
}
trash_delete() {
	trash_entry "$1" "$2" || return
	rm -rf "$src" || { fail 'Trash could not be emptied'; return; }
	rmdir "$r/.makhzan-trash/$1" 2>/dev/null
	usage_refresh
	ok
}
option_set() {
	case "$1:$2" in samba:0|samba:1|dlna:0|dlna:1|timemachine:0|timemachine:1) ;; *) fail 'Invalid option'; return;; esac
	[ "$1:$2" != timemachine:1 ] || tm_supported || { fail 'Time Machine needs the Samba fruit module'; return; }
	uci set "makhzan.main.$1=$2"; uci commit makhzan; ok
}
number_set() {
	case "$2" in ''|*[!0-9]*) fail 'Invalid option'; return;; esac
	[ ${#2} -le 6 ] || { fail 'Invalid option'; return; }
	case "$1" in
		timemachine_gb) ;;
		spindown) [ "$2" -le 720 ] || { fail 'Invalid option'; return; }
			[ "$2" -eq 0 ] || spindown_supported || { fail 'hd-idle is not installed'; return; };;
		*) fail 'Invalid option'; return;;
	esac
	n=$(printf '%s' "$2" | sed 's/^0*//'); uci set "makhzan.main.$1=${n:-0}"; uci commit makhzan; ok
}
dlna_rescan() {
	command -v minidlnad >/dev/null || { fail 'minidlna is not installed'; return; }
	[ "$(uci -q get makhzan.main.dlna)" = 1 ] || { fail 'Enable DLNA first'; return; }
	db=$(uci -q get minidlna.config.db_dir)
	case "$db" in /*) ;; *) db=/var/run/minidlna;; esac
	case "$db" in *..*) db=/var/run/minidlna;; esac
	/etc/init.d/minidlna stop >/dev/null 2>&1
	rm -f "$db/files.db"
	/etc/init.d/minidlna start >/dev/null 2>&1 || { fail 'MiniDLNA configuration or restart failed'; return; }
	ok
}
apply() {
	samba=$(uci -q get makhzan.main.samba); dlna=$(uci -q get makhzan.main.dlna)
	[ "$samba" != 1 ] || smb_installed || { fail 'samba4-server is not installed'; return 1; }
	[ "$dlna" != 1 ] || command -v minidlnad >/dev/null || { fail 'minidlna is not installed'; return 1; }
	ensure_layout || return 1
	r=$(root)
	smb_sync || { fail 'Samba configuration or restart failed'; return 1; }
	if [ "$dlna" = 1 ]; then
		uci -q get minidlna.config >/dev/null || { fail 'Unsupported MiniDLNA configuration'; return 1; }
		uci -q delete minidlna.config.media_dir
		uci add_list minidlna.config.media_dir="$r/media"; uci set minidlna.config.enabled=1
		! library_ready || uci add_list minidlna.config.media_dir="$LIB_TARGET"
		# TVs list the server by this name; replace only the package default, never a custom name.
		case "$(uci -q get minidlna.config.friendly_name)" in ''|'OpenWrt DLNA Server') uci set minidlna.config.friendly_name=Makhzan;; esac
		uci -q get minidlna.config.interface >/dev/null || uci set minidlna.config.interface=br-lan
		uci commit minidlna && /etc/init.d/minidlna enable && /etc/init.d/minidlna restart >/dev/null 2>&1 || { fail 'MiniDLNA configuration or restart failed'; return 1; }
	elif command -v minidlnad >/dev/null && uci -q get minidlna.config >/dev/null; then
		case " $(uci -q get minidlna.config.media_dir) " in *" $r/media "*)
			uci set minidlna.config.enabled=0; uci commit minidlna; /etc/init.d/minidlna stop >/dev/null 2>&1;;
		esac
	fi
	spindown_apply
	uci set makhzan.main.enabled=1; uci commit makhzan
	ok
}
boot() {
	trap '' HUP
	[ "$(uci -q get makhzan.main.enabled)" = 1 ] || return 0
	if smb_installed && grep -q '## makhzan-managed' "$SMB_TEMPLATE" 2>/dev/null; then
		tries=0; while [ "$tries" -lt 30 ] && ! pidof smbd >/dev/null; do sleep 2; tries=$((tries + 1)); done
		smb_policy || logger -t makhzan 'Samba lockout policy could not be applied'
	fi
	# USB disks can appear after init; wait up to a minute for the NAS mount before refreshing shares.
	tries=0; while [ "$tries" -lt 30 ] && ! root_remount; do sleep 2; tries=$((tries + 1)); done
	valid_root || { logger -t makhzan 'USB storage not ready at boot; shares will be refreshed on next apply'; return 0; }
	# Another Makhzan operation may hold the control lock briefly; retry before reporting.
	tries=0
	while :; do
		result=$(/usr/sbin/makhzanctl apply) && return 0
		tries=$((tries + 1)); [ "$tries" -lt 5 ] || break
		sleep 3
	done
	logger -t makhzan "Automatic apply failed: $result"
}
# Package removal (not upgrade) is complete: Makhzan's users, their Samba passwords and all Makhzan settings are
# deleted. Files on the disks are kept; every private folder moves to the recovery trash on the NAS, so the same
# usernames can be created again after a reinstall and the old files restored. The NAS, swap and extroot
# partitions stay as they are: they are disk layout, and the router may be running from the extroot.
uninstall() {
	cfg_root=$(root); r=$cfg_root; root_remount || r=''
	for u in $(managed_users); do
		h="$r/users/$u"
		if [ -n "$r" ] && [ -d "$h" ] && [ ! -L "$h" ] && makhzan_same_fs "$r" "$h" &&
			mkdir -p -m 0700 "$r/.makhzan-trash/$u" && makhzan_same_fs "$r" "$r/.makhzan-trash/$u"; then
			mv -n -T "$h" "$r/.makhzan-trash/$u/home:$(date +%Y%m%d-%H%M%S).$$"
		fi
		smb_installed && smbpasswd -x "$u" >/dev/null 2>&1
		# Also drop stale entries from the old smbpasswd file, which Samba uses again once tdbsam is reverted.
		[ ! -f /etc/samba/smbpasswd ] || sed -i "/^$u:/d" /etc/samba/smbpasswd
		account_remove "$u"
	done
	sed -i '/^makhzan:/d' /etc/group
	if smb_installed; then
		smb_clear
		[ "$(uci -q get makhzan.main.tm_macos)" != 1 ] || uci set samba4.@samba[0].macos=0
		uci commit samba4
		pdbedit -P 'bad lockout attempt' -C 0 >/dev/null 2>&1
		# Keep tdbsam only when it still holds accounts that Makhzan did not create.
		if [ -z "$(pdbedit -L 2>/dev/null)" ]; then smb_template_off all; else smb_template_off; fi
		/etc/init.d/samba4 restart >/dev/null 2>&1
	fi
	if command -v minidlnad >/dev/null && uci -q get minidlna.config >/dev/null; then
		case " $(uci -q get minidlna.config.media_dir) " in *" $cfg_root/media "*|*" $LIB_TARGET "*)
			uci -q del_list minidlna.config.media_dir="$cfg_root/media"; uci -q del_list minidlna.config.media_dir="$LIB_TARGET"
			[ "$(uci -q get minidlna.config.friendly_name)" != Makhzan ] || uci set minidlna.config.friendly_name='OpenWrt DLNA Server'
			uci set minidlna.config.enabled=0; uci commit minidlna; /etc/init.d/minidlna stop >/dev/null 2>&1;;
		esac
	fi
	# The media library is a read-only mount made for Makhzan: release it so the disk can be unplugged.
	if uci -q get fstab.makhzan_library >/dev/null || makhzan_mounted "$LIB_TARGET"; then
		sync; ! makhzan_mounted "$LIB_TARGET" || umount "$LIB_TARGET" 2>/dev/null || umount -l "$LIB_TARGET" 2>/dev/null
		rmdir "$LIB_TARGET" 2>/dev/null
		uci -q delete fstab.makhzan_library; uci commit fstab
	fi
	if spindown_supported && uci -q get hd-idle.makhzan >/dev/null; then
		uci -q delete hd-idle.makhzan; uci commit hd-idle; /etc/init.d/hd-idle restart >/dev/null 2>&1
	fi
	# A remote-access port must not stay open once Makhzan is gone.
	[ ! -x /usr/libexec/makhzan-remote ] || /usr/libexec/makhzan-remote disable >/dev/null 2>&1
	rm -f /etc/config/makhzan
	# Includes abandoned password tokens, usage cache, temporary files and the usage scan lock.
	# Keep this literal path: no configurable NAS path may ever reach this recursive cleanup.
	rm -rf /tmp/run/makhzan
	return 0
}

secret_dir
case "$1" in
	status|storage-devices|storage-plan|storage-job|list|boot|usage-scan|trash-list|library-list|remote-status) ;;
	*) control_lock;;
esac
case "$1" in
	status) status;;
	language) case "$2" in fa|en) uci set makhzan.main.language="$2"; uci commit makhzan; ok;; *) fail 'Invalid language';; esac;;
	storage-devices) /usr/libexec/makhzan-storage devices;;
	storage-plan) /usr/libexec/makhzan-storage plan "$2" "$3" "$4" "$5";;
	storage-apply) /usr/libexec/makhzan-storage apply "$2" "$3" "$4" "$5" "$6";;
	storage-job) /usr/libexec/makhzan-storage job;;
	storage-release) /usr/libexec/makhzan-storage release "$2";;
	storage-ready) storage_ready;;
	root) set_root "$2";;
	add-user) add_user "$2" "$3" "$4";;
	passwd) set_password "$2" "$3";;
	unlock) unlock_user "$2";;
	del-user) del_user "$2";;
	list) list_folders "$2";;
	mkdir) make_folder "$2" "$3";;
	rename) rename_folder "$2" "$3" "$4";;
	trash) trash_folder "$2" "$3";;
	trash-empty) empty_trash;;
	trash-list) trash_list;;
	trash-restore) trash_restore "$2" "$3";;
	trash-delete) trash_delete "$2" "$3";;
	usage-scan) usage_scan;;
	access) set_access "$2" "$3";;
	dlna-rescan) dlna_rescan;;
	storage-check) /usr/libexec/makhzan-storage check;;
	library-list) /usr/libexec/makhzan-storage library-list;;
	library-set|library-off)
		out=$(/usr/libexec/makhzan-storage "$1" "$2")
		case "$out" in *'"ok":true'*) apply >/dev/null 2>&1; ok;; *) printf '%s\n' "$out"; exit 1;; esac;;
	remote-*) /usr/libexec/makhzan-remote "${1#remote-}" "$2" "$3";;
	extroot-off) extroot_off;;
	option) option_set "$2" "$3";;
	set) number_set "$2" "$3";;
	apply) apply;;
	boot) boot;;
	uninstall) uninstall;;
	*) fail 'Unknown command'; exit 2;;
esac
